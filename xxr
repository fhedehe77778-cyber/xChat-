local function GetTime(Date)
    local Y, M, D, H, Min, S =
        Date:match(
            "^(%d+)/(%d+)/(%d+)%s+(%d+):(%d+):(%d+)$"
        )

    if not Y then
        return 0
    end

    return os.time({
        year = tonumber(Y),
        month = tonumber(M),
        day = tonumber(D),
        hour = tonumber(H),
        min = tonumber(Min),
        sec = tonumber(S)
    })
end

